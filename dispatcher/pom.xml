<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.lukasgrigis.blog.amqp</groupId>
    <artifactId>spring-oauth2-amqp-1.0</artifactId>
    <version>0.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>dispatcher</artifactId>
  <name>Dispatcher</name>
  <description>REST entry point — publishes jobs to the broker over an OAuth2-secured AMQP 1.0 connection</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring AMQP's RabbitMQ AMQP 1.0 client support: AmqpEnvironmentBuilder, SingleAmqpConnectionFactory,
         RabbitAmqpTemplate, RabbitAmqpListenerContainerFactory. Replaces spring-boot-starter-amqp (0.9.1).
         There is no Spring Boot auto-configuration for AMQP 1.0, so every bean is wired by hand. -->
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbitmq-client</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
