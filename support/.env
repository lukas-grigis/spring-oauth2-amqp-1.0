# Port mappings (host side)
WEB_PORT = "80"
RABBITMQ_AMQP_PORT = "5672"
RABBITMQ_MANAGEMENT_PORT = "15672"

# Images
TRAEFIK_IMAGE = "traefik:3.6"
KEYCLOAK_IMAGE = "quay.io/keycloak/keycloak:26.5"
# RabbitMQ 4.2+ is required for in-place OAuth2 token refresh on a live AMQP 1.0 connection
# (the HTTP-over-AMQP "PUT /auth/tokens" path). AMQP 1.0 itself is native since 4.0 — no plugin.
RABBITMQ_IMAGE = "rabbitmq:4.2-management"
POSTGRES_IMAGE = "postgres:18"
